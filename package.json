{
  "name": "sentinel-autonomy-lab",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "A browser-based, physics-driven quadrotor autonomy lab for visual target tracking and pursuit.",
  "license": "MIT",
  "author": "Sentinel Autonomy Lab",
  "homepage": "https://sbf-developer.github.io/panopticon-drone/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sbf-developer/panopticon-drone.git"
  },
  "bugs": {
    "url": "https://github.com/sbf-developer/panopticon-drone/issues"
  },
  "keywords": [
    "quadrotor",
    "autonomy",
    "simulation",
    "kalman-filter",
    "target-tracking",
    "threejs",
    "webgl"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/space-grotesk": "^5.3.0",
    "lucide-react": "^1.61.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6.1.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
